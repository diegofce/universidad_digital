# Development defaults. Never commit real credentials or secrets.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5433/universidad
APP_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_COOKIE_SECURE=false
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_EXPIRATION=30
ALLOWED_HOSTS=localhost,127.0.0.1
MAX_CREDITS_PER_PERIOD=30
